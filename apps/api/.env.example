PORT=8080
DATABASE_URL=postgres://survey:survey@localhost:5433/survey?sslmode=disable
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-value
# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000
# The single admin account, created on startup if missing (never overwritten)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
# Public self-registration (off unless "true")
ALLOW_REGISTRATION=false
# Load the demo survey + responses on startup
SEED_DEMO=false
